# AWS Security Group Management .gitignore

# Environment & Credentials
config.env
.env
*.pem
*.key
credentials
secrets*

# Reports and Output data (NEVER commit to git)
reports/
reports/**
audit_results/
audit_results/**
*.html
*.json
!test/*.json
!templates/*.html

# Backups (contain actual infrastructure SG JSON snapshots - NEVER commit to git)
backups/
backups/**
*.bak

# Temporary / Scratch files
.tmp_raw*
*.tmp

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Logs
logs/
*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
