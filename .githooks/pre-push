#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Push Hook: Guard against pushing sensitive reports or backups to remote
# ==============================================================================

FORBIDDEN_PATTERNS=(
    "^reports/"
    "^backups/"
    "^audit_results/"
    "\.pem$"
    "\.key$"
    "\.bak$"
    "config\.env$"
    "\.env$"
)

REMOTE="$1"
URL="$2"

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "${local_oid}" =~ ^0+$ ]]; then
        continue
    fi

    if [[ "${remote_oid}" =~ ^0+$ ]]; then
        RANGE="${local_oid}"
    else
        RANGE="${remote_oid}..${local_oid}"
    fi

    COMMITTED_FILES=$(git diff --name-only "${RANGE}" 2>/dev/null || true)

    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        MATCHES=$(echo "${COMMITTED_FILES}" | grep -E "${pattern}" || true)
        if [[ -n "${MATCHES}" ]]; then
            echo ""
            echo "[PUSH REJECTED] Security violation: Restricted file(s) detected in push to ${REMOTE}:"
            echo "${MATCHES}" | sed 's/^/  - /'
            echo "Reports and infrastructure backups must never be pushed to GitHub."
            echo ""
            exit 1
        fi
    done
done

exit 0
