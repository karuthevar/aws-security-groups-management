# ==============================================================================
# AWS Organization Security Group Audit & Cleanup Configuration
# Copy this file to 'config.env' and customize as needed.
# ==============================================================================

# Cross-Account IAM Role assumed in member accounts.
# Standard defaults: OrganizationAccountAccessRole (Organizations default), AWSControlTowerExecution (Control Tower)
ROLE_NAME="OrganizationAccountAccessRole"

# Comma-separated list of target AWS Account IDs. Leave empty to scan ALL active accounts in the Organization.
# Example: "111122223333,444455556666,777788889999"
SPECIFIC_ACCOUNTS=""

# Comma-separated list of AWS Regions to scan. Leave empty to scan all enabled regions in each account.
# Example: "us-east-1,us-west-2,eu-west-1"
SPECIFIC_REGIONS=""

# Destination directory for audit JSON datasets and HTML dashboards.
# OUTPUT_DIR="./audit_results"

# Destination directory for Security Group JSON backups.
# BACKUP_DIR="./backups"
